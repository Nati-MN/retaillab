# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://retaillab:retaillab@localhost:5432/retaillab?schema=public"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST="true"

# --- External providers (all optional) ------------------------------------
# Without these, RetailLab uses clearly labelled demo providers.
#
# PLACES_PROVIDER: "demo" (default) | "overpass" (OpenStreetMap, no key needed)
PLACES_PROVIDER="demo"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
# Identify your deployment to OSM services (required by their usage policy).
OSM_USER_AGENT="RetailLab/0.1 (contact: you@example.com)"

# AI_PROVIDER: "rules" (default, deterministic, no data leaves the server)
AI_PROVIDER="rules"
